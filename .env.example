# =====================================================================
# SGR — Archivo de configuración de ejemplo
# ---------------------------------------------------------------------
# Copiar como ".env" (junto a manage.py) y reemplazar los valores.
#   Linux/Mac:  cp .env.example .env
#   Windows:    copy .env.example .env
# Este archivo NO contiene credenciales reales. El archivo ".env" está en
# .gitignore y nunca debe subirse al repositorio.
# =====================================================================

# --- Django ----------------------------------------------------------
# Generar una clave nueva (mínimo 50 caracteres) con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=reemplazar-por-una-clave-larga-y-aleatoria

# True solo en un equipo local (runserver entrega los estáticos).
# En el servidor de producción: False.
DEBUG=True

# Hosts permitidos, separados por coma (sin espacios).
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos MySQL / MariaDB -----------------------------------
DB_NAME=evaluacion_db
DB_USER=usuario_sgr
DB_PASSWORD=reemplazar-por-la-clave-de-la-base
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Correo (recuperación de contraseña) -----------------------------
# Sin estas variables los correos se muestran en la consola.
# Para enviar correos reales usar el backend SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.ejemplo.cl
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=cuenta@ejemplo.cl
# EMAIL_HOST_PASSWORD=reemplazar-por-la-clave-de-aplicacion
# EMAIL_TIMEOUT=10
# DEFAULT_FROM_EMAIL=SGR La Serena <no-reply@ejemplo.cl>

# Vigencia del enlace de recuperación de contraseña, en segundos (1 hora).
PASSWORD_RESET_TIMEOUT=3600

# --- Archivos adjuntos (evidencias) ----------------------------------
# Carpeta donde se guardan los archivos subidos (no se publica por Nginx).
# MEDIA_ROOT=/ruta/absoluta/a/media
ADJUNTOS_MAX_ARCHIVOS=5
ADJUNTOS_MAX_MB_POR_ARCHIVO=10
ADJUNTOS_MAX_MB_TOTAL=25

# --- Reglas de la matriz SGR (R7 y R8) -------------------------------
# Bono por felicitación (+10 %), descuento por reclamo (-20 %) y tope de
# cumplimiento por ítem (120 %), expresados como fracción.
SGR_BONO_FELICITACION=0.10
SGR_DESCUENTO_RECLAMO=0.20
SGR_TOPE_CUMPLIMIENTO=1.20

# --- Alertas de registros sospechosos (R6) -----------------------------
# Contacto repetido: registros con el mismo vecino en una semana.
SGR_ALERTA_CONTACTO=3
# Ráfaga: N ingresos dentro de M minutos.
SGR_ALERTA_RAFAGA=5
SGR_ALERTA_RAFAGA_MINUTOS=10
# Detalle copiado: registros con el mismo texto en una semana.
SGR_ALERTA_DETALLE=3
# Cupo diario al máximo: días de una semana con los 7 ingresos.
SGR_ALERTA_CUPO_DIAS=3

# --- Prueba de estrés (tools/prueba_estres.py) -----------------------
# Usuario de prueba con el que se ejecuta la prueba de 50 usuarios.
# Usar una cuenta de ensayo, nunca una cuenta real.
# SGR_ESTRES_USUARIO=
# SGR_ESTRES_CLAVE=
